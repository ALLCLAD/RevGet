# ==============================================================================
# CONFIGURATION ENVIRONNEMENT - BACKEND (REVGET-API)
# ==============================================================================

# Port de l'API (défaut: 8080)
SERVER_PORT=8080

# Base de Données (NeonDB PostgreSQL en prod / ou Postgres local)
# Format NeonDB: jdbc:postgresql://ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/revget
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Emails des administrateurs (séparés par des virgules)
# Tout utilisateur se connectant avec un de ces emails obtiendra automatiquement le rôle ROLE_ADMIN
ADMIN_EMAILS=ton-email@gmail.com

# Clés API IA (Pour les prochaines phases RAG & Parsing)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxx
